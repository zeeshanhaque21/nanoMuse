# local configuration & secrets
config/config.toml
config/*.local.toml
.env
.env.*
!.env.example

# runtime data
workspace/
*.db
*.enc
*.key
audit.jsonl
sessions/
logs/

# python
__pycache__/
*.py[cod]
*.egg-info/

# typescript incremental build state (web/, harness/)
*.tsbuildinfo
.eggs/
build/
dist/
.venv/
venv/
# local pinned-interpreter venv used for CI-type checks (mypy); never committed
.venv-ci/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# web app sources (the production build in nanomuse/server/static IS committed)
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# website: generated from web/ and docs/ by `npm run site:mascot` (see site/README.md)
site/assets/
# the docs site, built by pages.yml from website/ into site/docs/
site/docs/

# nanoMuse on DeepSeek Harness (harness/README.md): built by `pnpm build`, not committed
harness/dsh-nanomuse/node_modules/
harness/dsh-nanomuse/lib/

# android app (the signing key lives outside the repo; see docs/android.md)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/.kotlin/
android/native/build/
*.jks
*.keystore
*.apk
*.aab

# editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# uv lockfile: the project installs with `uv pip install -e .`, not `uv sync`
uv.lock

# nanoMuse Cloud relay runtime data
cloud/data/

# Release signing passwords - consolidated copy, never commit (2026-10-04)
android/SIGNING-PASSWORDS.md
