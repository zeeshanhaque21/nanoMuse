# nanoMuse Cloud — copy to .env and fill in. Never commit .env.

# Public hostname (Caddy) and what the app is told to use as base URL.
CLOUD_DOMAIN=cloud.example.com
PUBLIC_BASE=https://cloud.example.com

# Long random strings (openssl rand -hex 32). CLOUD_SECRET keys the HMAC that
# hashes phone numbers and e-mail addresses (the lookup key) and the AES-GCM
# that stores them for the admin page; rotating it orphans every account, so
# back it up with the database. CLOUD_ADMIN_TOKEN opens /app/admin/ and the
# /v1/admin/* calls.
CLOUD_SECRET=
CLOUD_ADMIN_TOKEN=

# The provider the relay spends your money on (OpenAI-compatible endpoint).
# Defaults are Alibaba Model Studio (百炼); the same key serves both hosts.
UPSTREAM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/api/v1
# Pictures: at most this many drawn at once for everyone (the provider allows an account
# only a couple; more queue here), and 429/5xx retried this often before 429 provider_busy.
# IMAGE_CONCURRENCY=2
# IMAGE_RETRIES=4
# Merged into every chat request for fields the app did not set.
CHAT_DEFAULTS={"enable_thinking": false}

# Who may sign in. SIGNUP_OPEN=1 (the default) lets anyone with a number or an
# address register. The members below (comma-separated phone numbers / e-mail
# addresses) have no spend limit — the operator and friends; with
# SIGNUP_OPEN=0 they are the only ones who may sign in at all (a private relay).
# The admin page can also make any account a member without a restart.
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=

# Money (0.5). Everyone who is not a member has ALLOWANCE_CNY yuan for the
# account's lifetime — not a day — counted at the list prices in config.py (or
# CLOUD_MODELS) across chat, pictures and clips alike; 0 = no limit. The pool
# grows by INVITE_BONUS_CNY per new person who signs up with the account's
# invite code — the newcomer's pool grows by the same — and by whatever the
# admin page credits. When it is spent the apps offer that way and another:
# one's own model key (OWN_KEY_DOCS is the Bailian guide they open; OPENROUTER_URL
# the page for people outside mainland China, whom Bailian does not sign up —
# 0.17 orders the two by the person's region); sign-in and the hub keep working,
# only the model routes are gated. DAY_OFFSET_H only groups the operator's
# reports by local day (8 = Beijing). USD_CNY is for showing dollars next to yuan.
ALLOWANCE_CNY=10
INVITE_BONUS_CNY=5
# No default relay URLs: configure your own relay below.
# INVITE_URL=https://your-relay.example/web/?invite=
# OWN_KEY_DOCS=https://your-relay.example/own-key
# PRIVACY_URL=https://your-relay.example/privacy/
# REPO_URL=https://github.com/zeeshanhaque21/nanoMuse
OPENROUTER_URL=https://openrouter.ai/keys

# Data controls (0.9). "Help improve nanoMuse's AI models" keeps the text of an
# account's chat turns — what the person wrote, what the model answered and the
# tool calls it chose; never the system prompt, a tool's result or a picture —
# for the community's own model. IMPROVE_DEFAULT is what an account created
# from now on starts with: 1 = on until the person turns it off under Settings
# → Data controls, 0 = off until they turn it on. Accounts from before keep
# their setting. Say the default in the policy you link as PRIVACY_URL; the
# apps show it next to the switch.
IMPROVE_DEFAULT=0
# PRIVACY_URL=https://your-relay.example/privacy/
DAY_OFFSET_H=8
USD_CNY=7.1

# Tokens (the older allowance, still enforced when set). One phone/e-mail =
# one grant; 0 switches a limit off: SIGNUP_TOKENS=0 means no token ceiling at
# all (usage is still metered and shown as 「不限」 in the apps),
# DAILY_CAP_TOKENS=0 no daily token cap, PER_MINUTE_REQUESTS=0 no rate limit.
# The per-minute limit is what keeps a runaway loop from spending the whole
# allowance in one go.
SIGNUP_TOKENS=0
DAILY_CAP_TOKENS=0
PER_MINUTE_REQUESTS=30

# How verification codes go out: log | smtp | aliyun | both
# log   — printed to the server log only (development)
# smtp  — e-mail addresses only
# aliyun — mainland phone numbers via Dysmsapi (SendSms)
# both  — smtp for e-mail, aliyun for phones
CODE_SENDER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nanoMuse <no-reply@example.com>
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=

# Optional: replace the model menu (JSON list of ModelSpec fields; kind is
# chat | image | video, images cost per_image tokens each, clips per_clip;
# price_in / price_out are the provider's list prices in yuan per million tokens).
# A chat model says what it is "for": ["chat"], ["gui"] or both (0.17 — the apps'
# pickers filter on it; left out = ["chat"]), and "recommended_for" names the
# lane(s) it is the default pick in (needs "recommended": true; exactly one chat
# model per lane, or the log says so at start). Picture and clip models take no lanes.
# Shipped: deepseek-v4.1-flash (recommended for chat, sees pictures, ¥2 / ¥8),
# qwen3.8-27b (for gui and chat, recommended for gui, ¥3 / ¥12), qwen3.8-flash
# (chat, 0.3×), qwen-image-3.0 (pictures), wan2.2-i2v-flash and wan2.2-t2v-plus (clips).
# CLOUD_MODELS=[{"id":"deepseek-v4.1-flash","name":"DeepSeek V4.1 Flash","upstream":"deepseek-v4.1-flash","input_modalities":["text","image"],"for":["chat"],"recommended":true,"recommended_for":["chat"],"in_mult":0.7,"out_mult":0.7,"price_in":2.0,"price_out":8.0},{"id":"qwen3.8-27b","name":"Qwen 3.8 27B","upstream":"qwen3.8-27b","input_modalities":["text","image"],"for":["gui","chat"],"recommended":true,"recommended_for":["gui"],"price_in":3.0,"price_out":12.0}]

# Devices (the hub): every signed-in device keeps a WebSocket to /v1/hub so the
# account's phones, computers and the web console (/app) reach each other from
# any network. HUB_FRAME_LIMIT caps one frame (files and screenshots travel
# base64 inside frames).
HUB_ENABLED=true
HUB_FRAME_LIMIT=16777216
